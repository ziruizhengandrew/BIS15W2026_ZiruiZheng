names(wolves)
wolves %>%
filter(sex!="NA") %>%
ggplot(aes(x=sex, fill=sex))+
geom_bar()+
facet_wrap(~pop)
View(gestation)
library(shiny)
ui <- fluidPage(
selectInput("y",
choices = c("bodymass",
"longevity",
"gestationlength"),
selected = "bodymass"),
plotOutput("plot", width = "600px", length = "400px")
)
library(shiny)
ui <- fluidPage(
selectInput("y","Select Sleep Variable",
choices = c("bodymass",
"longevity",
"gestationlength"),
selected = "bodymass"),
plotOutput("plot", width = "600px", length = "400px")
)
library(shiny)
ui <- fluidPage(
selectInput("y","Select Sleep Variable",
choices = c("bodymass",
"longevity",
"gestationlength"),
selected = "bodymass"),
plotOutput("plot", width = "600px", height = "400px")
)
server <- function(input, output, session) {
output$plot <- renderPlot({
gestation%>%
ggplot(aes(x = order,
y = .data[[input$y]]))+
geom_boxplot(alpha = 0.75)+
labs(title = "Sleep Variables by Vore Type",
x="Order")+
theme_minimal()
})
}
shinyApp(ui, server)
