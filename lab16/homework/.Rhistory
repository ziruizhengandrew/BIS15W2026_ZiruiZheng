library(tidyverse)
library(janitor)
library(naniar)
library(ggmap)
library(lubridate)
library(shiny)
register_stadiamaps("30fa9419-b1e1-41e5-92fe-430ec32781d9", write = FALSE)
polar_bears <-
read_csv("data/polarBear_serumUreaCreatinine_beaufortChukchi_rode.csv") %>%
clean_names() %>%
select(-den_method, -no_cubs, -cub_age) %>%
filter(age_class==c("A", "S")) %>%
mutate(sex=toupper(sex),
age_class=toupper(age_class))
names(polar_bears)
summary(polar_bears)
polar_bears <- polar_bears %>%
replace_with_na_all(condition = ~ .x %in% c("unknown"))
gg_miss_var(polar_bears)
miss_var_summary(polar_bears)
# Answer: NAs is represented as unknown; it mainly distributed in mating and denning
polar_bears_1 <- polar_bears %>%
count(popn, sex)
polar_bears_1 %>%
ggplot(aes(x = popn, y = n, fill = sex)) +
geom_col(position = "dodge") +
labs(
title = "Number of Bears Sampled by Sex and Population",
x = "Population",
y = "Number of Sample"
) +
theme_minimal()
#Answer: Sampling isn't evenly distributed
polar_bears <- polar_bears %>%
mutate(year_capture = year(capture_date))
count_1 <- polar_bears  %>%
count(popn, year_capture)
count_1
count_1 %>%
ggplot(aes(x = year_capture, y = n, color = popn)) +
geom_line() +
geom_point() +
labs(
title = "Sampling of Polar Bears by Year",
x = "Year",
y = "Number of Samples of Bears"
) +
theme_minimal()
polar_bears %>%
select(urea_nitrogen,creatinine) %>%
summarize(
across(
where(is.numeric),
list(
mean   = ~mean(.x, na.rm = TRUE),
median = ~median(.x, na.rm = TRUE),
min    = ~min(.x, na.rm = TRUE),
max    = ~max(.x, na.rm = TRUE)
)
)
)
summary(polar_bears)
polar_bears$un_creat_ratio = polar_bears$urea_nitrogen * 0.466 / polar_bears$creatinine
polar_bears <- polar_bears %>%
mutate(
fasting = case_when(
un_creat_ratio <= 10 ~ "Fasting",
un_creat_ratio > 10 ~ "Not Fasting"
)
)
fasting_year <- polar_bears %>%
filter(fasting == "Fasting") %>%
count(popn, year)
View(polar_bears)
View(polar_bears_1)
View(polar_bears)
fasting_year <- polar_bears %>%
filter(fasting == "Fasting") %>%
count(popn, year_capture)
ggplot(fasting_year, aes(x = year, y = n, color = popn)) +
geom_line() +
geom_point() +
labs(
title = "Number of Fasting Polar Bears by Year",
x = "Year",
y = "Number of Fasting Bears"
) +
theme_minimal()
fasting_year <- polar_bears %>%
filter(fasting == "Fasting") %>%
count(popn, year_capture)
ggplot(fasting_year, aes(x = year_capture, y = n, color = popn)) +
geom_line() +
geom_point() +
labs(
title = "Number of Fasting Polar Bears by Year",
x = "Year",
y = "Number of Fasting Bears"
) +
theme_minimal()
