map2 <- get_stadiamap(bbox, maptype = "stamen_terrain", zoom = 7)
lat_p <- c(62.46,72.70)
long_p <- c(-172.2,-134.8 )
bbox <-make_bbox(long_p,lat_p,f=0.03)
map2 <- get_stadiamap(bbox, maptype = "stamen_terrain", zoom = 7)
