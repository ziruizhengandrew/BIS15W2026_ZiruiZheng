library(tidyverse)
library(janitor)
library(naniar)
amniota <- read_csv("data/amniota.csv") %>%
clean_names()
summary(amniota)
miss_var_summary(amniota)
amniota <- amniota %>%
View(amniota)
names(amniota)
amniota %>%
replace_with_na(replace_with_na_all(condition = ~.x ==-999))
