library(tidyverse)
library(janitor)
library(naniar)
amniota <- read_csv("data/amniota.csv") %>%
clean_names()
summary(amniota)
miss_var_summary(amniota)
amniota_na <- amniota %>%
replace_with_na_all(condition = ~ .x %in% c(-999, "", "NA"))
amniota_na %>%
miss_var_summary()
amniota_na %>%
replace_with_na(replace = list(female_maturity_d= -30258.7, adult_body_mass_g= 0, no_sex_body_mass_g = 0, birth_or_hatching_weight_g=0.000e+00))
summary(amniota_na)
amniota_na %>%
gg_miss_var()
##Answer: subspecies(considering this is a categorical variable, we might ignore),Female Body Mass at maturity gass.
amniota_na %>%
group_by(class) %>%
summarize(total_species = n(), egg_mass_na = sum(is.na(egg_mass_g))) %>%
arrange(desc(egg_mass_na))
## Answer: Yes. Mammals generally do not lay eggs, so we expected that egg_mass_NA mostly align with total_species. Birds all lay eggs, so the NAs in birds likely represent missing data . Reptiles also lay eggs，though some give live birth, so the high number of NAs in reptiles suggests substantial missing data.
amniota_na %>%
replace_with_na(replace = list(female_maturity_d= -30258.7, adult_body_mass_g= 0, no_sex_body_mass_g = 0, birth_or_hatching_weight_g=0.000e+00))
amniota_na %>%
mutate(
female_maturity_d = ifelse(female_maturity_d < 0, NA, female_maturity_d),
male_maturity_d   = ifelse(male_maturity_d < 0, NA, male_maturity_d),
maximum_longevity_y = na_if(maximum_longevity_y, 0),
birth_or_hatching_weight_g = na_if(birth_or_hatching_weight_g, 0),
no_sex_body_mass_g = na_if(no_sex_body_mass_g, 0)
)
summary(amniota_na)
amniota_na <- amniota_na %>%
mutate(
female_maturity_d = ifelse(female_maturity_d < 0, NA, female_maturity_d),
male_maturity_d   = ifelse(male_maturity_d < 0, NA, male_maturity_d),
maximum_longevity_y = na_if(maximum_longevity_y, 0),
birth_or_hatching_weight_g = na_if(birth_or_hatching_weight_g, 0),
no_sex_body_mass_g = na_if(no_sex_body_mass_g, 0)
)
summary(amniota_na)
amniota_na <- amniota_na %>%
mutate(
female_maturity_d = ifelse(female_maturity_d < 0, NA, female_maturity_d),
male_maturity_d   = ifelse(male_maturity_d < 0, NA, male_maturity_d),
maximum_longevity_y = na_if(maximum_longevity_y, 0),
birth_or_hatching_weight_g = na_if(birth_or_hatching_weight_g, 0),
no_sex_body_mass_g = na_if(no_sex_body_mass_g, 0),
adult_body_mass_g = na_if(adult_body_mass_g, 0)
)
summary(amniota_na)
amniota_na <- amniota_na %>%
mutate(
female_maturity_d = ifelse(female_maturity_d < 0, NA, female_maturity_d),
male_maturity_d   = ifelse(male_maturity_d < 0, NA, male_maturity_d),
birth_or_hatching_weight_g = na_if(birth_or_hatching_weight_g, 0), # the data from summary shows the rounding, thus we would see 0 from the table
no_sex_body_mass_g = na_if(no_sex_body_mass_g, 0), # the data from summary shows the rounding, thus we would see 0 from the table
adult_body_mass_g = na_if(adult_body_mass_g, 0)  # the data from summary shows the rounding, thus we would see 0 from the table
)
summary(amniota_na)
View(amniota)
View(amniota)
summary(amniota_na)
names(amniota_na)
